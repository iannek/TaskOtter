{
  "name": "taskotter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/main.ts\" \"vite --host 0.0.0.0\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "init": "tsx src/server/init.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security:check": "npm audit",
    "security:verify": "npm run security:check && npm run check && npm test && npm run build",
    "security:fix": "npm audit fix --ignore-scripts && npm run security:verify"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.4.17",
    "fastify": "^5.12.2",
    "marked": "^18.1.1",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.19.2",
    "concurrently": "^9.0.0",
    "json-schema-to-ts": "^3.1.1",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "4.1.11"
  }
}
